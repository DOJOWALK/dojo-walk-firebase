{
  "name": "dojo-walk-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "deploy": "npm run build && firebase deploy --only functions",
    "set-admin-claim": "node scripts/set-admin-claim.mjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dojo-walk --config ../firebase.json \"node --test test/firestore-rules.emulator.cjs\"",
    "test:payment-emulator": "firebase emulators:exec --only firestore --project demo-dojo-walk --config ../firebase.json \"node --test test/payment-finalizer.emulator.cjs\"",
    "test:reservation-emulator": "firebase emulators:exec --only firestore --project demo-dojo-walk --config ../firebase.json \"node --test test/reservation.emulator.cjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.17.2",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
